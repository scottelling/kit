{
  "version": "2.0.0",
  "purpose": "One production contract for every visual system distributed by Kit.",
  "systems": ["purple-rain", "jade", "os-kit", "animation-studio", "vanilla-kit"],
  "system_modes": {
    "purple-rain": ["light", "dark"],
    "jade": ["light", "dark"],
    "os-kit": ["light", "dark", "hacker", "ethereal", "paper"],
    "animation-studio": ["dark"],
    "vanilla-kit": ["light", "dark"]
  },
  "foundation_kits": ["shadow"],
  "catalog_layers": {
    "shared": "Everyday pieces available in every visual kit.",
    "specialty": "Specialist patterns available in every visual kit but installed only when the target product needs them.",
    "product_layout": "Product-owned screens and journeys that a kit may style but never silently replaces."
  },
  "specialty_install_policy": "opt-in",
  "foundations": [
    "semantic color roles in OKLCH",
    "declared color modes without inventing unsupported directions",
    "type roles and readable measure",
    "spacing, density, radius, border, and depth scales",
    "visible focus and reduced motion",
    "solid surfaces without glass, glow, or decorative gradients"
  ],
  "states": ["default", "hover", "focus", "active", "selected", "disabled", "loading", "empty", "error", "success"],
  "application_patterns": [
    "application-shell",
    "workspace-tree",
    "viewer-shell",
    "editor-toolbar",
    "task-board",
    "task-rail",
    "status-bar",
    "mobile-app-nav",
    "terminal-surface",
    "document-surface"
  ],
  "os_patterns": [
    "desktop-shell",
    "window-shell",
    "menu-bar",
    "dock",
    "widget-shell",
    "master-detail",
    "split-view",
    "command-bar",
    "settings-sheet"
  ],
  "animation_patterns": [
    "studio-shell",
    "studio-header",
    "workspace-switcher",
    "project-switcher",
    "storyboard-rail",
    "scene-list-item",
    "stage-viewport",
    "device-frame",
    "preview-toolbar",
    "ai-director",
    "command-suggestion-list",
    "inspector-panel",
    "layer-list",
    "style-inspector",
    "motion-inspector",
    "motion-preset-picker",
    "transport",
    "motion-timeline",
    "timeline-segment",
    "playhead",
    "delivery-workspace",
    "delivery-action",
    "render-status",
    "motion-check",
    "code-panel",
    "template-gallery",
    "guided-tour",
    "workspace-error-boundary"
  ],
  "viewports": [320, 375, 414, 768, 1280, 1440],
  "theme_workshop": {
    "source_kits_are_immutable": true,
    "saved_working_copies": true,
    "plain_language_and_direct_controls": true,
    "light_and_dark_proof": true,
    "exact_restore": true,
    "public_handoff": true
  },
  "signature_effects": {
    "isolated_from_visual_systems": true,
    "live_playground": true,
    "exact_source_handoff": true,
    "sound_opt_in": true,
    "offscreen_motion_pauses": true,
    "reduced_motion_is_static": true,
    "purpose_bound_effects_only": true
  },
  "requirements": {
    "minimum_control_height": "44px",
    "keyboard_operable": true,
    "rtl_ready": true,
    "public_registry": true,
    "downstream_install_proof": true,
    "plain_language_showroom": true
  }
}
